            self.lbl_img = tk.Label(self, image=self.img)
            self.lbl_img.place(x=180, y=20, width=100, height=100)
        except Exception:
            pass

        self.lbl_radio = tk.Label(self, text="Radio (cms):", anchor="w")
        self.lbl_radio.place(x=20, y=20, width=135, height=23)
        self.campo_radio = tk.Entry(self)
        self.campo_radio.place(x=20, y=45, width=135, height=23)

        self.lbl_altura = tk.Label(self, text="Altura (cms):", anchor="w")
        self.lbl_altura.place(x=20, y=75, width=135, height=23)
        self.campo_altura = tk.Entry(self)
        self.campo_altura.place(x=20, y=100, width=135, height=23)

        self.btn_calcular = tk.Button(self, text="Calcular", command=self.calcular)
        self.btn_calcular.place(x=20, y=135, width=135, height=25)

        self.lbl_volumen = tk.Label(self, text="Volumen (cm3):", anchor="w")
        self.lbl_volumen.place(x=20, y=180, width=260, height=23)

        self.lbl_superficie = tk.Label(self, text="Superficie (cm2):", anchor="w")
        self.lbl_superficie.place(x=20, y=210, width=260, height=23)

    def calcular(self):
        try:
            radio = float(self.campo_radio.get().strip().replace(',', '.'))
            altura = float(self.campo_altura.get().strip().replace(',', '.'))
            cilindro = Cilindro(radio, altura)
            self.lbl_volumen.config(text=f"Volumen (cm3): {cilindro.get_volumen():.2f}")
            self.lbl_superficie.config(text=f"Superficie (cm2): {cilindro.get_superficie():.2f}")
        except ValueError:
            messagebox.showerror("Error", "Campo nulo o error en formato de número", parent=self)


